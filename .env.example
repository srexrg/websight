NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL

# Supabase API keys - new key system (Project Settings -> API Keys).
# Public key for browser/auth clients:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Required by the v2 analytics pipeline (ingestion + queries + backfill):
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy JWT keys still work as fallbacks if your project has not migrated:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: structured ingestion logging / query timing logs
# DEBUG_TRACKING=1
# ANALYTICS_QUERY_LOG=1

# Session replay object store (docs/redesign/24). All five required for
# recording playback and delete to work; the default cloud target is
# Cloudflare R2, but any S3-compatible endpoint works (MinIO, AWS S3,
# Supabase Storage's S3 endpoint).
# REPLAY_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# REPLAY_S3_BUCKET=websight-replays
# REPLAY_S3_ACCESS_KEY_ID=...
# REPLAY_S3_SECRET_ACCESS_KEY=...
# REPLAY_S3_REGION=auto
# Guards /api/internal/replay-expiry (the daily retention cron). Vercel sends
# it as a Bearer token automatically once this is set in project env vars.
# CRON_SECRET=...
